<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.prog_tech_lab2.task2.Task2Controller"
      spacing="8" prefWidth="900" prefHeight="650">

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Task 2: Factory Method — логические элементы"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Номер элемента (0..4):"/>
        <TextField fx:id="tfNumber" prefWidth="70"/>
        <Label text="Контур:"/>
        <ColorPicker fx:id="colorpicker"/>
        <Label text="Заливка:"/>
        <ColorPicker fx:id="fillPicker"/>
        <Button text="Выполнить" onAction="#onDraw">

        </Button>
    </HBox>

    <HBox spacing="20" alignment="CENTER_LEFT">
        <Label text="0 — OR"/>
        <Label text="1 — NOR"/>
        <Label text="2 — NAND"/>
        <Label text="3 — AND"/>
        <Label text="4 — NOT"/>
    </HBox>

    <HBox spacing="8">
        <Button text="← Task 1" onAction="#goToTask1"/>
        <Button text="→ Task 3" onAction="#goToTask3"/>
        <Button text="→ Task 4" onAction="#goToTask4"/>
    </HBox>

    <Canvas fx:id="canvas" width="880" height="520"/>
    <Label fx:id="lblInfo" text="Элемент: -"/>
</VBox>