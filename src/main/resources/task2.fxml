<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650" prefWidth="900" spacing="8" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.prog_tech_lab2.task2.Task2Controller">

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Task 2: Factory Method — логические элементы">
         <font>
            <Font size="14.0" />
         </font></Label>
      <VBox.margin>
         <Insets left="10.0" top="10.0" />
      </VBox.margin>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Номер элемента (0..4):">
         <font>
            <Font size="14.0" />
         </font></Label>
        <TextField fx:id="tfNumber" prefWidth="70">
         <font>
            <Font size="14.0" />
         </font></TextField>
      <Label text="Цвет контура :">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <ColorPicker fx:id="StrokeColorPicker" />
      <Label text="Цвет заливки :">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <ColorPicker fx:id="FillColorPicker" />
        <Button onAction="#onDraw" text="Выполнить">
         <font>
            <Font size="14.0" />
         </font></Button>
      <VBox.margin>
         <Insets left="10.0" top="10.0" />
      </VBox.margin>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="0 — OR">
         <font>
            <Font size="14.0" />
         </font></Label>
        <Label text="1 — NOR">
         <font>
            <Font size="14.0" />
         </font></Label>
        <Label text="2 — NAND">
         <font>
            <Font size="14.0" />
         </font></Label>
        <Label text="3 — AND">
         <font>
            <Font size="14.0" />
         </font></Label>
        <Label prefHeight="20.0" prefWidth="67.0" text="4 — NOT">
         <font>
            <Font size="14.0" />
         </font></Label>
      <VBox.margin>
         <Insets left="10.0" top="10.0" />
      </VBox.margin>
    </HBox>

    <HBox spacing="8">
        <Button onAction="#goToTask1" text="← Task 1">
         <font>
            <Font size="14.0" />
         </font></Button>
        <Button onAction="#goToTask3" text="→ Task 3">
         <font>
            <Font size="14.0" />
         </font></Button>
      <VBox.margin>
         <Insets left="10.0" top="10.0" />
      </VBox.margin>
    </HBox>

    <Canvas fx:id="canvas" height="520" width="880" />
    <Label fx:id="lblInfo" text="Элемент: -" />
</VBox>
