<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650" prefWidth="900" spacing="8" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.prog_tech_lab2.task1.Task1Controller">
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Task 1: Abstract Superclass">
         <font>
            <Font size="14.0" />
         </font></Label>
        <Label text="Размер:">
         <font>
            <Font size="14.0" />
         </font></Label>
        <TextField fx:id="tfSize" prefWidth="70">
         <font>
            <Font size="14.0" />
         </font></TextField>
        <Label text="Цвет заливки:">
         <font>
            <Font size="14.0" />
         </font></Label>
        <ColorPicker fx:id="FillColorPicker" />
      <Label text="Цвет контура:">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <ColorPicker fx:id="StrokeColorPicker" />
      <opaqueInsets>
         <Insets />
      </opaqueInsets>
      <VBox.margin>
         <Insets left="10.0" top="10.0" />
      </VBox.margin>
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Button onAction="#onCircle" text="Круг">
         <font>
            <Font size="14.0" />
         </font></Button>
        <Button onAction="#onEllipse" text="Эллипс">
         <font>
            <Font size="14.0" />
         </font></Button>
        <Button onAction="#onRectangle" text="Прямоугольник">
         <font>
            <Font size="14.0" />
         </font></Button>
        <Button onAction="#onRoundedRectangle" text="Скругл. прямоугольник">
         <font>
            <Font size="14.0" />
         </font></Button>
        <Button onAction="#onSquare" text="Квадрат">
         <font>
            <Font size="14.0" />
         </font></Button>
        <Button fx:id="btnToTask2" onAction="#goToTask2" text="→ Task 2">
         <font>
            <Font size="14.0" />
         </font></Button>
      <VBox.margin>
         <Insets left="10.0" top="10.0" />
      </VBox.margin>
    </HBox>
    <Canvas fx:id="canvas" height="540" width="880" />
    <Label fx:id="lblInfo" text="Последняя фигура: -">
      <font>
         <Font size="14.0" />
      </font>
      <VBox.margin>
         <Insets bottom="10.0" left="10.0" />
      </VBox.margin></Label>
</VBox>
