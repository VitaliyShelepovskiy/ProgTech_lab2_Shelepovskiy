<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.prog_tech_lab2.task1.Task1Controller"
      spacing="8" prefWidth="900" prefHeight="650">

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Task 1: Abstract Superclass"/>
        <Label text="Размер:"/>
        <TextField fx:id="tfSize" prefWidth="70"/>
        <Label text="Контур:"/>
        <ColorPicker fx:id="colorpicker"/>
        <Label text="Заливка:"/>
        <ColorPicker fx:id="fillPicker"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="Круг" onAction="#onCircle"/>
        <Button text="Эллипс" onAction="#onEllipse"/>
        <Button text="Прямоугольник" onAction="#onRectangle"/>
        <Button text="Скругл. прямоугольник" onAction="#onRoundedRectangle"/>
        <Button text="Квадрат" onAction="#onSquare"/>
        <Button text="→ Task 2" onAction="#goToTask2"/>
        <Button text="→ Task 4" onAction="#goToTask4"/>
    </HBox>

    <Canvas fx:id="canvas" width="880" height="540"/>
    <Label fx:id="lblInfo" text="Последняя фигура: -"/>
</VBox>